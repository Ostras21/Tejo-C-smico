        <file alias="nivel1/tejo.png">../sprites/nivel1/tejo.png</file>
        <file alias="nivel1/mecha.png">../sprites/nivel1/mecha.png</file>
        <file alias="nivel1/roca.png">../sprites/nivel1/roca.png</file>
        <file alias="nivel1/superficie_lunar.png">../sprites/nivel1/superficie_lunar.png</file>
        <file alias="nivel2/enemigo.png">../sprites/nivel2/enemigo.png</file>
        <file alias="nivel2/comandante.png">../sprites/nivel2/comandante.png</file>
        <file alias="nivel2/anillos_de_saturno.png">../sprites/nivel2/anillos_de_saturno.png</file>
